# Copy this file to .env and fill in your real local PostgreSQL credentials.
#
# Format:
#   postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Your system already has PostgreSQL 18 installed locally, so HOST is
# normally "localhost" and PORT is normally 5432 (the Postgres default).
#
# Example (replace USERNAME / PASSWORD / DATABASE with your own):
DATABASE_URL="postgres://7ed07fcd5ed6d2c020c5ae5e151313a4d9bcde5a4db7c710500a590f4077eb5b:sk_rAo9Qb73tZDBDfE8VE0FC@pooled.db.prisma.io:5432/postgres?sslmode=require"

# WhatsApp test-number credentials — for the /inbox "send real message" demo
# feature only (used for the Meta App Review video). Get these from your
# Meta App → WhatsApp → API Setup page. This is NOT the real per-client
# WhatsApp integration — just enough to prove message-sending works.
META_TEST_PHONE_NUMBER_ID=""
META_TEST_ACCESS_TOKEN=""

# Webhook verify token — you make this up yourself (any random string), put
# it here AND paste the same value into the Meta App dashboard when you
# configure the webhook (WhatsApp → Configuration → Webhooks). Required for
# real delivered/read status updates on the Message Status page — see
# README-BACKEND.md for the full setup (needs a public URL; ngrok for local
# dev). Leave blank if you're not setting this up yet.
META_WEBHOOK_VERIFY_TOKEN=""

# WhatsApp Account Setup (app/(app)/whatsapp-setup) — real per-client
# connections. Any random string works for the encryption key (it's hashed
# to a proper key internally) — just don't lose/change it once clients have
# connected, or their stored tokens become unreadable and they'll need to
# reconnect.
CREDENTIALS_ENCRYPTION_KEY="hinu@rosni@2015xyz"

# Only needed for the "Connect via Facebook" (Embedded Signup) button —
# "Enter manually" works without these. From your Meta App dashboard:
# NEXT_PUBLIC_META_APP_ID is the App ID (visible in the URL, e.g.
# developers.facebook.com/apps/<this-number>). META_APP_SECRET is under
# App Settings → Basic. NEXT_PUBLIC_META_CONFIG_ID is created under
# Facebook Login for Business → Configurations, after choosing the
# "WhatsApp Embedded Signup" use case (requires whatsapp_business_management
# advanced access to be approved by App Review first).
NEXT_PUBLIC_META_APP_ID=""
META_APP_SECRET=""
NEXT_PUBLIC_META_CONFIG_ID=""
