# Copy this file to .env and fill in your real local PostgreSQL credentials.
#
# Format:
#   postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Your system already has PostgreSQL 18 installed locally, so HOST is
# normally "localhost" and PORT is normally 5432 (the Postgres default).
#
# Example (replace USERNAME / PASSWORD / DATABASE with your own):
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/whatsapp_cms?schema=public"
