// WhatsApp CMS — database schema
//
// Phase 1: Client module (Super Admin ⇄ Clients) + Client Admin login.
// Phase 2: Super Admin login (AdminUser below) — a single, real,
// database-backed admin account. There is deliberately no "create another
// admin" flow anywhere in the app; see scripts/create-admin.ts and
// scripts/reset-admin-password.ts for how the one admin account is
// provisioned and recovered, from the terminal only.
// Contacts Phase A: the Contact model below — CRUD, search, filter, tags.
// CSV/Excel import and saved contact lists are Contacts Phase B, not yet
// built.
// Templates Phase 1: CustomTemplate below — Create + listing only (no
// Edit/Delete yet). Meta-Approved templates stay mock data (data/campaigns.ts)
// until real Meta WhatsApp Business API integration, a later phase.
// Campaigns: the Campaign model below — Draft / Send Now / Schedule are all
// real. "Send Now" runs immediately via Meta's test-number API (same scope
// as /api/bulk-send). "Schedule" is picked up by an in-process scheduler
// (lib/campaignScheduler.ts) that only runs while the Node server is up —
// see that file for why this is a real-but-limited implementation.
//
// Everything else (subscriptions, etc.) is still frontend-only /
// localStorage in this phase, and will move to the database in a later
// phase.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  active
  suspended
  expired
}

/// A client account created by the Super Admin. Each row is one business
/// (tenant) with its own login (userId + passwordHash) and its own CMS
/// workspace.
model Client {
  id           String       @id @default(cuid())
  name         String
  userId       String       @unique
  passwordHash String
  email        String
  phone        String
  startDate    DateTime     @db.Date
  expiryDate   DateTime     @db.Date
  status       ClientStatus @default(active)
  /// Cached/manual contact count shown on the Clients list — NOT the same as
  /// `contactRecords.length`. Kept as-is from Phase 1; real contacts (below)
  /// are tracked separately and the two aren't reconciled yet.
  messagesSent Int          @default(0)
  contacts     Int          @default(0)
  plan         String       @default("Free Trial")

  /// Real Settings → Notifications / Preferences (Settings page). Free-form
  /// JSON rather than dedicated columns since these are simple per-user
  /// key/value toggles with no query/filter needs of their own — same
  /// reasoning as CustomTemplate.buttons. Null until the user saves that
  /// tab once; the frontend applies its own defaults until then.
  notificationPrefs Json?
  cmsPrefs          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  contactRecords Contact[]
  customTemplates CustomTemplate[]
  campaigns Campaign[]
  queueSettings QueueSettings?
  queueJobs QueueJob[]
  messageRecords MessageRecord[]
  whatsappAccount WhatsAppAccount?

  @@map("clients")
}

/// Backs the httpOnly login cookie for a Client Admin. One row per active
/// login; deleting the row (logout, or expiry) invalidates the session.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("sessions")
}

/// The single Super Admin account. Deliberately no "role" field and no
/// second row is ever expected — there is exactly one admin, provisioned via
/// `npm run create-admin` (terminal only, refuses to run if a row already
/// exists) and recovered via `npm run reset-admin-password`.
model AdminUser {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  name         String
  email        String
  phone        String?

  /// Real Settings → Notifications / Preferences — see the matching fields
  /// on Client for why these are JSON.
  notificationPrefs Json?
  cmsPrefs          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AdminSession[]

  @@map("admin_users")
}

/// Backs the httpOnly login cookie for the Super Admin. Same pattern as
/// `Session`, kept as a separate table/cookie so an admin login and a client
/// login can never be confused with each other.
model AdminSession {
  id        String    @id @default(cuid())
  token     String    @unique
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@map("admin_sessions")
}

enum ContactConsent {
  opted_in
  opted_out
  pending
}

/// A contact belonging to exactly one client (tenant). Phone is the only
/// required field — see ContactsPage / ContactForm. Tags are a plain string
/// array (no separate Tag table yet); GET /api/contacts/tags returns the
/// distinct set already in use, for the tag picker.
model Contact {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name  String?
  phone String
  email String?
  tags  String[] @default([])

  consent       ContactConsent @default(opted_in)
  consentSource String         @default("Manual entry")
  consentDate   DateTime       @default(now()) @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One phone number per client — importing/adding the same number twice
  // for the same client is a duplicate, not a second contact.
  @@unique([clientId, phone])
  @@index([clientId])
  @@map("contacts")
}

enum TemplateCategory {
  Marketing
  Utility
  Authentication
}

enum CustomTemplateStatus {
  draft
  custom
}

enum TemplateMediaKind {
  none
  image
  video
  document
}

/// A client's own WhatsApp message template — Templates Phase 1 scope is
/// Create + listing only; there's no Edit/Delete yet (see ContactForm-style
/// note in app/(app)/templates/page.tsx). Meta-Approved templates are NOT in
/// this table — they stay mock data (data/campaigns.ts) until real Meta API
/// integration.
model CustomTemplate {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name     String
  language String
  category TemplateCategory
  status   CustomTemplateStatus @default(draft)

  header String?
  body   String
  footer String?

  mediaKind     TemplateMediaKind @default(none)
  /// Public path under /uploads/templates/... — see app/api/templates/media.
  /// Not an external URL: the file is uploaded and stored on this server's
  /// disk (public/uploads/), not a cloud bucket.
  mediaUrl      String?
  mediaFileName String?

  /// Array of { id, kind: "url" | "call" | "whatsapp", label, url } — "url"
  /// holds the link for url/whatsapp buttons, or the phone number for call
  /// buttons. Stored as Json since Postgres/Prisma has no native array-of-
  /// object column type.
  buttons   Json     @default("[]")
  variables String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A client shouldn't have two templates with the same name.
  @@unique([clientId, name])
  @@index([clientId])
  @@map("custom_templates")
}

enum CampaignStatus {
  draft
  scheduled
  sending
  completed
  cancelled
  failed
}

/// A bulk-send campaign belonging to one client. Audience is a tag filter
/// over that client's own Contact rows (like Bulk Sender) — "all" (or null)
/// means every opted-in contact. templateId/templateName are a loose
/// reference + snapshot (not a hard foreign key) so the campaign still
/// displays sensibly even if the template is later edited or deleted.
model Campaign {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name         String
  audienceTag  String? // null/"all" = every opted-in contact
  templateId   String
  templateName String

  status      CampaignStatus @default(draft)
  scheduledAt DateTime?

  /// Snapshot of the matching audience size at the time the campaign was
  /// created or last (re)scheduled — the real count is re-checked again
  /// right before sending.
  audienceSize Int @default(0)
  sentCount    Int @default(0)
  failedCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

enum QueueJobStatus {
  queued
  processing
  completed
  failed
}

/// One row per client — rate-limit knobs used by lib/queueProcessor.ts.
/// Created lazily with sane defaults the first time a client's settings are
/// read (see lib/queueSettings.ts), so no seed data is needed.
model QueueSettings {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  messagesPerMinute Int     @default(250)
  batchSize         Int     @default(250)
  maxRetryAttempts  Int     @default(3)
  /// While true, no NEW batches start (queued jobs stay queued; a batch
  /// already mid-send finishes first) — see lib/queueProcessor.ts.
  paused            Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("queue_settings")
}

/// One batch of contacts from a single campaign/bulk send. Real rate
/// limiting happens by spacing out the individual sends inside a batch
/// (lib/queueProcessor.ts); this row is the visible, retryable unit of work.
model QueueJob {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Campaign this batch belongs to — null for a one-off Bulk Sender send.
  campaignId String?
  /// Display name (campaign/bulk-send name at the time this batch was queued).
  name String

  /// Contact ids in this batch — used to actually (re)send on "Retry".
  contactIds String[]
  templateId String
  /// The fully-filled message text at the time this batch was queued —
  /// stored so "Retry" sends exactly the same message even if the source
  /// template has since been edited.
  messageText String @default("")

  batchSize   Int
  attempts    Int            @default(0)
  maxAttempts Int            @default(3)
  status      QueueJobStatus @default(queued)
  sentCount   Int            @default(0)
  failedCount Int            @default(0)
  errorMessage String?
  lastRunAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("queue_jobs")
}

enum MessageStatusValue {
  sent
  delivered
  read
  failed
}

/// One row per actual WhatsApp send attempt (real — created by
/// lib/queueProcessor.ts for every contact it sends to, whether it
/// succeeded or failed). delivered/read only ever get filled in if Meta's
/// delivery-status webhook is configured and reachable — see
/// app/api/webhooks/meta/route.ts and README-BACKEND.md for the real setup
/// this requires (a public URL; ngrok for local dev).
model MessageRecord {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  campaignId   String?
  campaignName String?
  queueJobId   String?

  recipientName  String?
  recipientPhone String

  templateId   String?
  templateName String?
  preview      String

  /// Meta's id for this specific message — how the webhook matches an
  /// incoming status update back to this row. Unique because Meta's ids are
  /// globally unique, so no clientId is needed to disambiguate a webhook hit.
  whatsappMessageId String? @unique
  status            MessageStatusValue
  errorMessage      String?

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("message_records")
}

/// One row per client — the real, per-client WhatsApp Business Account
/// connection made via Meta's Embedded Signup flow (see
/// app/(app)/whatsapp-setup/page.tsx and app/api/whatsapp-setup/*).
/// Replaces the shared META_TEST_* env vars used everywhere else in this
/// app so far — once connected, this client's own sends should use these
/// credentials instead (a follow-up wiring step, not part of this model).
model WhatsAppAccount {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Manually tracked progress through the setup checklist shown on the
  /// page — real and persisted, but independent of Meta's own state (we
  /// have no way to verify e.g. "Business verified" from our side).
  checklistDone Int[] @default([])

  connected     Boolean   @default(false)
  businessName  String?
  wabaId        String?
  phoneNumberId String?
  displayNumber String?
  qualityRating String?
  /// AES-256-GCM ciphertext (base64: iv.authTag.ciphertext) — see
  /// lib/crypto.ts. Never stored or returned in plain text.
  accessTokenEnc String?
  connectedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_accounts")
}
